<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_vshn_demo" model="res.partner">
        <field name="name">VSHN AG</field>
        <field name="email">info@vshn.ch</field>
        <field name="website">https://www.vshn.ch</field>
        <field name="phone">+41 44 500 86 00</field>
        <field name="street">Neugasse 10</field>
        <field name="city">Zürich</field>
        <field name="zip">8005</field>
        <field name="country_id" ref="base.ch" />
    </record>

    <record id="res_partner_localhost_demo" model="res.partner">
        <field name="name">Localhost Development</field>
        <field name="email">dev@localhost.test</field>
        <field name="website">http://localhost</field>
        <field name="phone">+41 44 123 45 67</field>
        <field name="street">Developer Street 42</field>
        <field name="city">Localhost</field>
        <field name="zip">1234</field>
        <field name="country_id" ref="base.ch" />
    </record>

    <record id="kubectl_cluster_kind_demo" model="kubectl.cluster">
        <field name="name">Kind</field>
        <field name="alias">loc</field>
        <field name="server">https://127.0.0.1:35249</field>
        <field name="domain">knd.local</field>
        <field name="partner_id" ref="kubectl.res_partner_localhost_demo" />
    </record>

    <record id="kubectl_cluster_axo_demo" model="kubectl.cluster">
        <field name="name">APPUiO</field>
        <field name="server">https://api.exoscale-ch-gva-2-0.appuio.cloud:6443</field>
        <field name="alias">axo</field>
        <field name="domain">axo.mintcloud.ch</field>
        <field name="partner_id" ref="kubectl.res_partner_vshn_demo" />
    </record>

    <record id="kubectl_namespace_default_demo" model="kubectl.namespace">
        <field name="name">default</field>
        <field name="cluster_id" ref="kubectl_cluster_kind_demo" />
    </record>

    <record id="kubectl_context_kind_demo" model="kubectl.context">
        <field name="name">Admin</field>
        <field name="cluster_id" ref="kubectl_cluster_kind_demo" />
    </record>

    <record id="kubectl_context_axo_demo" model="kubectl.context">
        <field name="name">Admin</field>
        <field name="cluster_id" ref="kubectl_cluster_axo_demo" />
    </record>

    <record id="kubectl_cluster_kind_demo" model="kubectl.cluster">
        <field name="context_id" ref="kubectl.kubectl_context_kind_demo" />
    </record>

    <record id="kubectl_cluster_axo_demo" model="kubectl.cluster">
        <field name="context_id" ref="kubectl.kubectl_context_axo_demo" />
    </record>

    <record id="base.user_admin" model="res.users">
        <field
            name="kubectl_context_ids"
            eval="[(4, ref('kubectl_context_kind_demo'))]"
        />
    </record>
</odoo>
