<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helm_release_form_view" model="ir.ui.view">
        <field name="name">sale_helm.helm_release_form_view</field>
        <field name="model">helm.release</field>
        <field name="inherit_id" ref="helm.helm_release_form_view" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="sale_line_id" />
            </field>
            <xpath expr="//sheet/div[@class='oe_title']" position="before">
                <div name="button_box" class="oe_button_box">
                    <button
                        name="action_view_sale_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-dollar"
                        invisible="not sale_line_id"
                    >
                        <div class="o_form_field o_stat_info">
                            <span class="o_stat_text">Sale Order</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
