<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="chart_nextcloud" model="helm.chart">
        <field name="name">nextcloud</field>
        <field name="repo_id" ref="helm.repo_kubernetes_build" />
        <field
            name="customer_notice_template"
        ><![CDATA[
Getting started guide: https://wiki.mint-system.ch/mint-cloud-odoo-erste-schritte.html
]]></field>
    </record>

    <record id="product_nextcloud" model="product.product">
        <field name="name">Nextcloud</field>
        <field name="type">service</field>
        <field name="list_price">20</field>
        <field name="chart_id" ref="helm.chart_nextcloud" />
    </record>

    <record id="chart_nextcloud_value_nextcloud_host" model="helm.chart.value">
        <field name="chart_id" ref="helm.chart_nextcloud" />
        <field name="path">nextcloud.host</field>
        <field name="value">release.namespace + '.' + release.cluster_id.domain</field>
    </record>
</odoo>
