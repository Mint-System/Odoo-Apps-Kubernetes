<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ingress_nginx" model="helm.repo">
        <field name="name">ingress-nginx</field>
        <field name="state">added</field>
        <field name="url">https://kubernetes.github.io/ingress-nginx</field>
    </record>

    <record id="chart_ingress_nginx" model="helm.chart">
        <field name="name">ingress-nginx</field>
        <field name="repo_id" ref="helm.ingress_nginx" />
    </record>

    <record id="cnpg" model="helm.repo">
        <field name="name">cnpg</field>
        <field name="state">added</field>
        <field name="url">https://cloudnative-pg.github.io/charts</field>
    </record>

    <record id="chart_cloudnative_pg" model="helm.chart">
        <field name="name">cloudnative-pg</field>
        <field name="repo_id" ref="helm.cnpg" />
    </record>

    <record id="repo_kubernetes_build" model="helm.repo">
        <field name="name">kubernetes-build</field>
        <field name="state">added</field>
        <field name="url">https://kubernetes.build</field>
    </record>

    <record id="chart_odoo" model="helm.chart">
        <field name="name">odoo</field>
        <field name="repo_id" ref="helm.repo_kubernetes_build" />
        <field
            name="customer_notice_template"
        ><![CDATA[
<p>
Getting started guide: <a href="https://wiki.mint-system.ch/mint-cloud-erste-schritte.html">Mint Cloud Odoo - Erste Schritte</a>
</br>
</br>
Production: <a t-attf-href="https://{{ release.get_value('ingress.host') }}">staging.<t t-out="release.get_value('ingress.host')" /></a>
<t t-if="release.get_value('ingress.customDomain')">
Custom Domain: <a t-attf-href="https://{{ release.get_value('ingress.customDomain') }}"><t t-out="release.get_value('ingress.customDomain')" /></a>
</br>
</t>
</br>
</br>
<t t-if="release.get_value('staging.enabled')">
Staging: <a t-attf-href="https://staging.{{ release.get_value('ingress.host') }}">staging.<t t-out="release.get_value('ingress.host')" /></a>
</br>
</br>
</t>
Your login credentials:
<ul>
<li>Username: <t t-out="release.get_value('init.login')" /></li>
<li>Password: <t t-out="release.get_value('init.password')" /></li>
</ul>
</p>
]]></field>
    </record>

    <record id="product_odoo_community_edition" model="product.product">
        <field name="name">Odoo Community Edition</field>
        <field name="type">service</field>
        <field name="list_price">50</field>
        <field name="chart_id" ref="helm.chart_odoo" />
    </record>

    <record id="product_odoo_enterprise_edition" model="product.product">
        <field name="name">Odoo Enterprise Edition</field>
        <field name="type">service</field>
        <field name="list_price">80</field>
        <field name="chart_id" ref="helm.chart_odoo" />
    </record>

    <record id="chart_odoo_value_ingress_host" model="helm.chart.value">
        <field name="chart_id" ref="helm.chart_odoo" />
        <field name="path">ingress.host</field>
        <field name="value">release.namespace + '.' + release.cluster_id.domain</field>
    </record>

    <record id="chart_odoo_value_staging_enable" model="helm.chart.value">
        <field name="path">staging.enabled</field>
        <field name="value">True</field>
        <field name="chart_id" eval="chart_odoo" />
    </record>

    <record id="chart_odoo_value_init_login" model="helm.chart.value">
        <field name="path">init.login</field>
        <field name="value">release.partner_id.email</field>
        <field name="chart_id" eval="chart_odoo" />
    </record>

    <record id="chart_odoo_value_init_lang" model="helm.chart.value">
        <field name="path">init.lang</field>
        <field name="value">release.partner_id.lang</field>
        <field name="chart_id" eval="chart_odoo" />
    </record>

    <record id="chart_odoo_value_init_password" model="helm.chart.value">
        <field name="path">init.password</field>
        <field name="value">generate_password()</field>
        <field name="release_chart_id" eval="chart_odoo" />
        <field name="readonly" eval="True" />
    </record>

    <record id="chart_odoo_value_image_option1" model="helm.chart.value.option">
        <field name="path">image</field>
        <field name="value">mintsystem/odoo:18.0.20251222</field>
    </record>

    <record id="chart_odoo_value_image_option2" model="helm.chart.value.option">
        <field name="path">image</field>
        <field name="value">mintsystem/odoo:18.0.20260119</field>
    </record>

    <record id="chart_odoo_value_image_option3" model="helm.chart.value.option">
        <field name="path">image</field>
        <field name="value">mintsystem/odoo:18.0.20260209</field>
    </record>

    <record id="chart_odoo_value_image" model="helm.chart.value">
        <field name="path">image</field>
        <field name="release_chart_id" eval="chart_odoo" />
        <field name="option_id" ref="chart_odoo_value_image_option3" />
    </record>

    <record id="chart_odoo_value_download_enterprise" model="helm.chart.value">
        <field name="chart_id" ref="helm.chart_odoo" />
        <field name="path">downloadOdooEnterprise</field>
        <field name="value">True</field>
        <field
            name="filter_product_ids"
            eval="[(4, ref('product_odoo_enterprise_edition'))]"
        />
    </record>
</odoo>
