<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="chart_odoo" model="helm.chart">
        <field name="name">odoo</field>
        <field name="repo_id" ref="helm.repo_kubernetes_build" />
        <field
            name="customer_notice_template"
        ><![CDATA[
Getting started guide: https://wiki.mint-system.ch/mint-cloud-erste-schritte.html
</br>
Your environments:
</br>
Production: https://<t t-out="release.get_value('ingress.host')" />
<t t-if="release.get_value('ingress.customDomain')">
Custom Domain: https://<t t-out="release.get_value('ingress.customDomain')" />
</t>
<t t-if="release.get_value('staging.enabled')">
Staging: https://staging.<t t-out="release.get_value('ingress.host')" />
</t>
</br>
Your login credentials:
</br>
Username: <t t-out="release.get_value('init.login')" />
Password: <t t-out="release.get_value('init.password')" />
]]></field>
    </record>

    <record id="chart_nextcloud" model="helm.chart">
        <field name="name">nextcloud</field>
        <field name="repo_id" ref="helm.repo_kubernetes_build" />
        <field
            name="customer_notice_template"
        ><![CDATA[
Getting started guide: https://wiki.mint-system.ch/mint-cloud-erste-schritte.html
]]></field>
    </record>

    <record id="product_attribute_version" model="product.attribute">
        <field name="name">Version</field>
        <field name="sequence">1</field>
    </record>
    <record id="product_attribute_version_17_0" model="product.attribute.value">
        <field name="name">17.0</field>
        <field name="attribute_id" ref="product_attribute_version" />
        <field name="sequence">3</field>
    </record>
    <record id="product_attribute_version_18_0" model="product.attribute.value">
        <field name="name">18.0</field>
        <field name="attribute_id" ref="product_attribute_version" />
        <field name="sequence">2</field>
    </record>
    <record id="product_attribute_version_19_0" model="product.attribute.value">
        <field name="name">19.0</field>
        <field name="attribute_id" ref="product_attribute_version" />
        <field name="sequence">1</field>
    </record>

    <record id="product_odoo_community_edition" model="product.product">
        <field name="name">Odoo Community Edition</field>
        <field name="type">service</field>
        <field name="list_price">50</field>
        <field name="chart_id" ref="helm.chart_odoo" />
    </record>
    <record
        id="product_odoo_community_edition_attribute_version"
        model="product.template.attribute.line"
    >
        <field
            name="product_tmpl_id"
            ref="product_odoo_community_edition_product_template"
        />
        <field name="attribute_id" ref="product_attribute_version" />
        <field
            name="value_ids"
            eval="[(6, 0, [
            ref('helm.product_attribute_version_17_0'),
            ref('helm.product_attribute_version_18_0'),
            ref('helm.product_attribute_version_19_0'),
        ])]"
        />
    </record>
    <function model="ir.model.data" name="_update_xmlids">
        <value
            model="base"
            eval="[{
            'xml_id': 'helm.product_odoo_community_edition_version_19_0',
            'record': obj().env.ref('helm.product_odoo_community_edition_attribute_version').product_template_value_ids[0],
            'noupdate': True,
        }, {
            'xml_id': 'helm.product_odoo_community_edition_version_18_0',
            'record': obj().env.ref('helm.product_odoo_community_edition_attribute_version').product_template_value_ids[1],
            'noupdate': True,
        }, {
            'xml_id': 'helm.product_odoo_community_edition_version_17_0',
            'record': obj().env.ref('helm.product_odoo_community_edition_attribute_version').product_template_value_ids[2],
            'noupdate': True,
        }]"
        />
    </function>
    <function model="ir.model.data" name="_update_xmlids">
        <value
            model="base"
            eval="[{
            'xml_id': 'helm.product_odoo_community_edition_19_0',
            'record': obj().env.ref('helm.product_odoo_community_edition_product_template')._get_variant_for_combination(
                obj().env.ref('helm.product_odoo_community_edition_version_19_0')
            ),
            'noupdate': True,
        }, {
            'xml_id': 'helm.product_odoo_community_edition_18_0',
            'record': obj().env.ref('helm.product_odoo_community_edition_product_template')._get_variant_for_combination(
                obj().env.ref('helm.product_odoo_community_edition_version_18_0')
            ),
            'noupdate': True,
        }, {
            'xml_id': 'helm.product_odoo_community_edition_17_0',
            'record': obj().env.ref('helm.product_odoo_community_edition_product_template')._get_variant_for_combination(
                obj().env.ref('helm.product_odoo_community_edition_version_17_0')
            ),
            'noupdate': True,
        }]"
        />
    </function>

    <record id="product_odoo_enterprise_edition" model="product.product">
        <field name="name">Odoo Enterprise Edition</field>
        <field name="type">service</field>
        <field name="list_price">50</field>
        <field name="chart_id" ref="helm.chart_odoo" />
    </record>
    <record
        id="product_odoo_enterprise_edition_attribute_version"
        model="product.template.attribute.line"
    >
        <field
            name="product_tmpl_id"
            ref="product_odoo_enterprise_edition_product_template"
        />
        <field name="attribute_id" ref="product_attribute_version" />
        <field
            name="value_ids"
            eval="[(6, 0, [
            ref('helm.product_attribute_version_17_0'),
            ref('helm.product_attribute_version_18_0'),
            ref('helm.product_attribute_version_19_0'),
        ])]"
        />
    </record>
    <function model="ir.model.data" name="_update_xmlids">
        <value
            model="base"
            eval="[{
            'xml_id': 'helm.product_odoo_enterprise_edition_version_19_0',
            'record': obj().env.ref('helm.product_odoo_enterprise_edition_attribute_version').product_template_value_ids[0],
            'noupdate': True,
        }, {
            'xml_id': 'helm.product_odoo_enterprise_edition_version_18_0',
            'record': obj().env.ref('helm.product_odoo_enterprise_edition_attribute_version').product_template_value_ids[1],
            'noupdate': True,
        }, {
            'xml_id': 'helm.product_odoo_enterprise_edition_version_17_0',
            'record': obj().env.ref('helm.product_odoo_enterprise_edition_attribute_version').product_template_value_ids[2],
            'noupdate': True,
        }]"
        />
    </function>
    <function model="ir.model.data" name="_update_xmlids">
        <value
            model="base"
            eval="[{
            'xml_id': 'helm.product_odoo_enterprise_edition_19_0',
            'record': obj().env.ref('helm.product_odoo_enterprise_edition_product_template')._get_variant_for_combination(
                obj().env.ref('helm.product_odoo_enterprise_edition_version_19_0')
            ),
            'noupdate': True,
        }, {
            'xml_id': 'helm.product_odoo_enterprise_edition_18_0',
            'record': obj().env.ref('helm.product_odoo_enterprise_edition_product_template')._get_variant_for_combination(
                obj().env.ref('helm.product_odoo_enterprise_edition_version_18_0')
            ),
            'noupdate': True,
        }, {
            'xml_id': 'helm.product_odoo_enterprise_edition_17_0',
            'record': obj().env.ref('helm.product_odoo_enterprise_edition_product_template')._get_variant_for_combination(
                obj().env.ref('helm.product_odoo_enterprise_edition_version_17_0')
            ),
            'noupdate': True,
        }]"
        />
    </function>

    <record id="chart_odoo_value_ingress_host" model="helm.chart.value">
        <field name="chart_id" ref="helm.chart_odoo" />
        <field name="path">ingress.host</field>
        <field name="value">release.namespace + '.' + release.cluster_id.domain</field>
        <field name="help">The domain name of the Odoo instance.</field>
    </record>
    <record id="chart_odoo_value_staging_enable" model="helm.chart.value">
        <field name="path">staging.enabled</field>
        <field name="value">True</field>
        <field name="chart_id" eval="chart_odoo" />
        <field name="help">Deploy an Odoo staging enviroment.</field>
    </record>
    <record id="chart_odoo_value_init_login" model="helm.chart.value">
        <field name="path">init.login</field>
        <field name="value">release.partner_id.email</field>
        <field name="chart_id" eval="chart_odoo" />
        <field name="help">Username of the admin user.</field>
    </record>
    <record id="chart_odoo_value_init_lang" model="helm.chart.value">
        <field name="path">init.lang</field>
        <field name="value">release.partner_id.lang</field>
        <field name="chart_id" eval="chart_odoo" />
        <field name="help">Language of the Odoo database.</field>
    </record>
    <record id="chart_odoo_value_init_password" model="helm.chart.value">
        <field name="path">init.password</field>
        <field name="value">generate_password()</field>
        <field name="release_chart_id" eval="chart_odoo" />
        <field name="readonly" eval="True" />
        <field name="help">Generated password of the admin user.</field>
    </record>

    <record id="chart_odoo_value_image_19_0" model="helm.chart.value">
        <field name="path">image</field>
        <field name="release_chart_id" eval="chart_odoo" />
        <field
            name="filter_product_ids"
            eval="[
            (4, ref('helm.product_odoo_community_edition_19_0')),
            (4, ref('helm.product_odoo_enterprise_edition_19_0')),
        ]"
        />
        <field name="help">Odoo version and revision.</field>
    </record>
    <record id="chart_odoo_value_image_19_0_option1" model="helm.chart.value.option">
        <field name="value">mintsystem/odoo:19.0.20260305</field>
        <field name="value_ids" eval="[(4, ref('chart_odoo_value_image_19_0'))]" />
    </record>
    <record id="chart_odoo_value_image_19_0_option2" model="helm.chart.value.option">
        <field name="value">mintsystem/odoo:19.0.20260409</field>
        <field name="value_ids" eval="[(4, ref('chart_odoo_value_image_19_0'))]" />
    </record>

    <record id="chart_odoo_value_image_18_0" model="helm.chart.value">
        <field name="path">image</field>
        <field name="release_chart_id" eval="chart_odoo" />
        <field
            name="filter_product_ids"
            eval="[
            (4, ref('helm.product_odoo_community_edition_18_0')),
            (4, ref('helm.product_odoo_enterprise_edition_18_0')),
        ]"
        />
        <field name="help">Odoo version and revision.</field>
    </record>
    <record id="chart_odoo_value_image_18_0_option1" model="helm.chart.value.option">
        <field name="value">mintsystem/odoo:18.0.20260305</field>
        <field name="value_ids" eval="[(4, ref('chart_odoo_value_image_18_0'))]" />
    </record>
    <record id="chart_odoo_value_image_18_0_option2" model="helm.chart.value.option">
        <field name="value">mintsystem/odoo:18.0.20260409</field>
        <field name="value_ids" eval="[(4, ref('chart_odoo_value_image_18_0'))]" />
    </record>

    <record id="chart_odoo_value_image_17_0" model="helm.chart.value">
        <field name="path">image</field>
        <field name="release_chart_id" eval="chart_odoo" />
        <field
            name="filter_product_ids"
            eval="[
            (4, ref('helm.product_odoo_community_edition_17_0')),
            (4, ref('helm.product_odoo_enterprise_edition_17_0')),
        ]"
        />
        <field name="help">Odoo version and revision.</field>
    </record>
    <record id="chart_odoo_value_image_17_0_option1" model="helm.chart.value.option">
        <field name="value">mintsystem/odoo:17.0.20260305</field>
        <field name="value_ids" eval="[(4, ref('chart_odoo_value_image_17_0'))]" />
    </record>
    <record id="chart_odoo_value_image_17_0_option2" model="helm.chart.value.option">
        <field name="value">mintsystem/odoo:17.0.20260409</field>
        <field name="value_ids" eval="[(4, ref('chart_odoo_value_image_17_0'))]" />
    </record>

    <record id="chart_odoo_value_download_enterprise" model="helm.chart.value">
        <field name="chart_id" ref="helm.chart_odoo" />
        <field name="path">downloadOdooEnterprise</field>
        <field name="value">True</field>
        <field
            name="filter_product_ids"
            eval="[
            (4, ref('helm.product_odoo_enterprise_edition_17_0')),
            (4, ref('helm.product_odoo_enterprise_edition_18_0')),
            (4, ref('helm.product_odoo_enterprise_edition_19_0')),
        ]"
        />
        <field name="help">Download and install Odoo Enterprise modules.</field>
    </record>
</odoo>
