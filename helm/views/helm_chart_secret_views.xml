<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helm_chart_secret_list_view" model="ir.ui.view">
        <field name="name">helm.helm_chart_secret_list_view</field>
        <field name="model">helm.chart.secret</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="chart_id" />
                <field name="release_id" />
            </list>
        </field>
    </record>

    <record id="helm_chart_secret_form_view" model="ir.ui.view">
        <field name="name">helm.helm_chart_secret_form_view</field>
        <field name="model">helm.chart.secret</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_get_uid" string="Get UID" type="object" />
                </header>
                <sheet>
                    <field name="data_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="key" />
                            <field name="value" widget="password" />
                        </list>
                    </field>
                    <group>
                        <field name="uid" />
                        <field name="chart_id" readonly="True" />
                        <field name="release_id" readonly="True" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helm_chart_secret_view" model="ir.actions.act_window">
        <field name="name">Secrets</field>
        <field name="res_model">helm.chart.secret</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="helm.menu_helm_secrets"
        name="Secrets"
        parent="helm.menu_root"
        action="helm.action_helm_chart_secret_view"
        sequence="16"
    />
</odoo>
