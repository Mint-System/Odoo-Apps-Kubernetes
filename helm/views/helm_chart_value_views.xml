<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helm_chart_value_list_view" model="ir.ui.view">
        <field name="name">helm.helm_chart_value_list_view</field>
        <field name="model">helm.chart.value</field>
        <field name="arch" type="xml">
            <list>
                <field name="path" />
                <field name="value" />
                <field name="filter_cluster_ids" widget="many2many_tags" />
                <field name="filter_product_ids" widget="many2many_tags" />
                <field name="chart_id" />
                <field name="release_id" />
            </list>
        </field>
    </record>

    <record id="helm_chart_value_form_view" model="ir.ui.view">
        <field name="name">helm.helm_chart_value_form_view</field>
        <field name="model">helm.chart.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="filter_cluster_ids" widget="many2many_tags" />
                            <field name="filter_product_ids" widget="many2many_tags" />
                            <field name="path" />
                            <field name="value" />
                            <field name="option_id" context="{'default_path': path}" />
                        </group>
                        <group>
                            <field name="chart_id" readonly="True" />
                            <field name="release_chart_id" readonly="True" />
                            <field name="release_id" readonly="True" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helm_chart_value_option_form_view" model="ir.ui.view">
        <field name="name">helm.helm_chart_value_option_form_view</field>
        <field name="model">helm.chart.value.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="path" />
                            <field name="value" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helm_chart_value_view" model="ir.actions.act_window">
        <field name="name">Values</field>
        <field name="res_model">helm.chart.value</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="helm.menu_helm_values"
        name="Values"
        parent="helm.menu_root"
        action="helm.action_helm_chart_value_view"
        sequence="15"
    />
</odoo>
